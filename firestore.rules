rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper function to check if user is the authorized admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == "julioalejandrosalazar05@gmail.com" || 
         request.auth.token.email == "vicentemontano59@gmail.com");
    }

    // Marcas: Public read, admin write
    match /marcas/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Productos: Public read for store catalog, admin write
    match /productos/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ventas: Public create, admin read and write
    match /ventas/{saleId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Tendencias por Estado en Venezuela
    match /tendencias_estado/{tendenciaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

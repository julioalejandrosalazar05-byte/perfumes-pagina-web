rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Marcas: Public read, admin write
    match /marcas/{brandId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Productos: Public read for store catalog, admin write
    match /productos/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Ventas: Public create, admin read and write
    match /ventas/{saleId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // Tendencias por Estado en Venezuela
    match /tendencias_estado/{tendenciaId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
